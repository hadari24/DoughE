{
  "info": {
    "name": "Dough-E API (Assignment 4)",
    "description": "Full-stack Dough-E API: MySQL + Sequelize, Socket.IO, and AI. Base URL variable: baseUrl (default http://localhost:3000). Role is simulated with the x-user-role header; current user with x-user-id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"hadar@dough.com\",\n  \"password\": \"123456\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [ { "key": "x-user-id", "value": "1", "type": "text" } ],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get all users",
          "request": {
            "method": "GET",
            "header": [ { "key": "x-user-role", "value": "admin", "type": "text" } ],
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [ { "key": "x-user-role", "value": "user", "type": "text" } ],
            "url": { "raw": "{{baseUrl}}/api/users/1", "host": ["{{baseUrl}}"], "path": ["api", "users", "1"] }
          }
        },
        {
          "name": "Get user by id - not found (404)",
          "request": {
            "method": "GET",
            "header": [ { "key": "x-user-role", "value": "user", "type": "text" } ],
            "url": { "raw": "{{baseUrl}}/api/users/999", "host": ["{{baseUrl}}"], "path": ["api", "users", "999"] }
          }
        },
        {
          "name": "Create user (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-user-role", "value": "admin", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Dana\",\n  \"lastName\": \"Cohen\",\n  \"userRole\": \"user\",\n  \"email\": \"dana@dough.com\",\n  \"password\": \"123456\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Create user - validation error (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-user-role", "value": "admin", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Dana\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
          }
        },
        {
          "name": "Update user (manager)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "x-user-role", "value": "manager", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Shir\",\n  \"lastName\": \"Battat\",\n  \"userRole\": \"admin\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/users/2", "host": ["{{baseUrl}}"], "path": ["api", "users", "2"] }
          }
        },
        {
          "name": "Update user - self (user)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "x-user-role", "value": "user", "type": "text" },
              { "key": "x-user-id", "value": "4", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Matan\",\n  \"lastName\": \"Perez\",\n  \"userRole\": \"user\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/users/4", "host": ["{{baseUrl}}"], "path": ["api", "users", "4"] }
          }
        },
        {
          "name": "Delete user (admin)",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "x-user-role", "value": "admin", "type": "text" } ],
            "url": { "raw": "{{baseUrl}}/api/users/5", "host": ["{{baseUrl}}"], "path": ["api", "users", "5"] }
          }
        }
      ]
    },
    {
      "name": "Recipes",
      "item": [
        {
          "name": "Get all recipes",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/recipes", "host": ["{{baseUrl}}"], "path": ["api", "recipes"] }
          }
        },
        {
          "name": "Filter by difficulty",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/recipes?difficulty=easy", "host": ["{{baseUrl}}"], "path": ["api", "recipes"], "query": [ { "key": "difficulty", "value": "easy" } ] }
          }
        },
        {
          "name": "Filter by dough family",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/recipes?doughFamily=sourdough", "host": ["{{baseUrl}}"], "path": ["api", "recipes"], "query": [ { "key": "doughFamily", "value": "sourdough" } ] }
          }
        },
        {
          "name": "Get recipe by id (JOIN: author + ingredients)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/recipes/1", "host": ["{{baseUrl}}"], "path": ["api", "recipes", "1"] }
          }
        },
        {
          "name": "Get recipe - not found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/recipes/999", "host": ["{{baseUrl}}"], "path": ["api", "recipes", "999"] }
          }
        },
        {
          "name": "Create recipe (manager)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-user-role", "value": "manager", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Focaccia\",\n  \"doughFamily\": \"yeast-based\",\n  \"hydration\": 80,\n  \"difficulty\": \"medium\",\n  \"totalTimeMinutes\": 180,\n  \"steps\": [\"Mix\", \"Rest\", \"Dimple and bake\"],\n  \"ingredients\": [\n    { \"name\": \"flour\", \"amount\": 500, \"unit\": \"g\" },\n    { \"name\": \"water\", \"amount\": 400, \"unit\": \"ml\" },\n    { \"name\": \"olive oil\", \"amount\": 30, \"unit\": \"ml\" },\n    { \"name\": \"salt\", \"amount\": 10, \"unit\": \"g\" }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/recipes", "host": ["{{baseUrl}}"], "path": ["api", "recipes"] }
          }
        },
        {
          "name": "Create recipe - forbidden (403, as user)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-user-role", "value": "user", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Nope\",\n  \"doughFamily\": \"batter\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/recipes", "host": ["{{baseUrl}}"], "path": ["api", "recipes"] }
          }
        },
        {
          "name": "Update recipe (manager)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "x-user-role", "value": "manager", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"difficulty\": \"hard\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/recipes/1", "host": ["{{baseUrl}}"], "path": ["api", "recipes", "1"] }
          }
        },
        {
          "name": "Delete recipe (admin)",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "x-user-role", "value": "admin", "type": "text" } ],
            "url": { "raw": "{{baseUrl}}/api/recipes/6", "host": ["{{baseUrl}}"], "path": ["api", "recipes", "6"] }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Get recipe comments",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/recipes/1/comments", "host": ["{{baseUrl}}"], "path": ["api", "recipes", "1", "comments"] }
          }
        }
      ]
    },
    {
      "name": "Likes",
      "item": [
        {
          "name": "Like a recipe",
          "request": {
            "method": "POST",
            "header": [ { "key": "x-user-id", "value": "1", "type": "text" } ],
            "url": { "raw": "{{baseUrl}}/api/recipes/2/like", "host": ["{{baseUrl}}"], "path": ["api", "recipes", "2", "like"] }
          }
        },
        {
          "name": "Unlike a recipe",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "x-user-id", "value": "1", "type": "text" } ],
            "url": { "raw": "{{baseUrl}}/api/recipes/2/like", "host": ["{{baseUrl}}"], "path": ["api", "recipes", "2", "like"] }
          }
        },
        {
          "name": "My liked recipes",
          "request": {
            "method": "GET",
            "header": [ { "key": "x-user-id", "value": "1", "type": "text" } ],
            "url": { "raw": "{{baseUrl}}/api/likes", "host": ["{{baseUrl}}"], "path": ["api", "likes"] }
          }
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "Get settings",
          "request": {
            "method": "GET",
            "header": [ { "key": "x-user-id", "value": "1", "type": "text" } ],
            "url": { "raw": "{{baseUrl}}/api/settings", "host": ["{{baseUrl}}"], "path": ["api", "settings"] }
          }
        },
        {
          "name": "Update settings",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "x-user-id", "value": "1", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"userName\": \"Hadar\",\n  \"email\": \"hadar@dough.com\",\n  \"theme\": \"pink\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/settings", "host": ["{{baseUrl}}"], "path": ["api", "settings"] }
          }
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Ask the Chef (general)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "body": { "mode": "raw", "raw": "{\n  \"prompt\": \"Why is my dough too sticky?\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/ai/assistant", "host": ["{{baseUrl}}"], "path": ["api", "ai", "assistant"] }
          }
        },
        {
          "name": "Ask the Chef (with recipe context)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json", "type": "text" } ],
            "body": { "mode": "raw", "raw": "{\n  \"prompt\": \"How do I make this less dense?\",\n  \"context\": \"The user is viewing the recipe Classic Pizza Dough (yeast-based, 65% hydration).\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/ai/assistant", "host": ["{{baseUrl}}"], "path": ["api", "ai", "assistant"] }
          }
        }
      ]
    }
  ]
}
